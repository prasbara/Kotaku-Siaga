# ============================================================
# KotaKu Siaga — Environment Variables Template
# ============================================================
# Salin file ini ke .env.local dan isi dengan nilai nyata.
# JANGAN commit .env.local ke repository.
# Isi credential di Vercel → Settings → Environment Variables saat deployment.
# ============================================================

# ─── PUBLIC VARIABLES (exposed to browser) ──────────────────

# URL aplikasi (required)
# Development: http://localhost:3000
# Production: https://kotakusiaga.yourdomain.com
NEXT_PUBLIC_APP_URL=

# Supabase Project URL (required)
# Dapatkan dari: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous/Public Key (required)
# Aman untuk diekspos ke browser. Bukan service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo mode flag (optional, default: false)
# JANGAN set ke "true" di production — akan mengubah behavior dashboard.
NEXT_PUBLIC_DEMO_MODE=false

# ─── SERVER-ONLY SECRETS (NEVER expose to client/browser) ───

# Supabase Service Role Key (required for server-side DB operations)
# PERINGATAN: Jangan pernah set sebagai NEXT_PUBLIC_* variable.
# Jangan pernah expose ke browser bundle.
# Dapatkan dari: https://app.supabase.com → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter AI API Key (optional — for AI report analysis)
# Dapatkan dari: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model (optional — defaults to free tier)
OPENROUTER_MODEL=

# Seed Secret (optional — required only if using /api/seed endpoint)
# Buat nilai acak yang kuat, misalnya: openssl rand -hex 32
# Jangan gunakan nilai default atau mudah ditebak.
# Jika tidak dikonfigurasi, endpoint /api/seed dinonaktifkan sepenuhnya.
SEED_SECRET=
