# ============================================================
# KotaKu Siaga — Environment Variables Template
# ============================================================
# Salin file ini ke .env.local dan isi dengan nilai nyata.
# JANGAN commit .env.local atau file .env lainnya ke repository.
# Masukkan credential di Vercel → Settings → Environment Variables saat deployment.
# ============================================================

# ─── PUBLIC CLIENT CONFIG (Aman untuk diekspos ke browser) ──

# URL aplikasi (required)
# Development: http://localhost:3000
# Production: https://kotaku-siaga.vercel.app
NEXT_PUBLIC_APP_URL=

# Supabase Project URL (required)
# Dapatkan dari: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous/Publishable Key (required)
# Dapatkan dari: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo mode flag (optional, default: false)
# JANGAN set ke "true" di production — akan mengubah behavior dashboard.
NEXT_PUBLIC_DEMO_MODE=false

# Cloudflare Turnstile Anti-Bot Site Key (Public)
# Dapatkan dari Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── SERVER-ONLY SECRETS (JANGAN PERNAH EXPOSE KE BROWSER) ──

# Supabase Service Role / Secret Key (required for server-side operations)
# PERINGATAN: Jangan pernah set sebagai NEXT_PUBLIC_* variable.
# Dapatkan dari: https://app.supabase.com → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase PostgreSQL Direct DB Password (optional, for direct pg migrations)
SUPABASE_DB_PASSWORD=

# OpenRouter AI API Key (required for Civic AI Copilot & report analysis)
# Dapatkan dari: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_KEYS=
OPENROUTER_MODEL=openrouter/free

# Google Gemini / Cloud AI Vision Key (required for evidence verification)
# Dapatkan dari: https://aistudio.google.com/app/apikey atau Google Cloud Console
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEY=
GOOGLE_API_KEY=

# Cloudflare Turnstile Secret Key (Server-side validation)
# Dapatkan dari Cloudflare Dashboard -> Turnstile
TURNSTILE_SECRET_KEY=

# Admin Cryptographic HMAC Session Secret (optional, falls back to Supabase service key)
ADMIN_SESSION_SECRET=

# NASA FIRMS API Key (optional — for live VIIRS/MODIS thermal anomaly ingestion)
# Dapatkan dari: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Seed Secret (optional — required only if using /api/seed endpoint)
SEED_SECRET=
